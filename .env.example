# --- Required ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- Optional sources ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Lyrics come from LRCLIB (no key needed); Genius is only a fallback
GENIUS_API_TOKEN=

# --- Web dashboard (set the first two to turn it on) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Any long random string. Keeps people signed in across restarts.
DASHBOARD_SECRET_KEY=
# The address people open. Add <this>/callback as a redirect in the Developer Portal.
DASHBOARD_URL=http://localhost:8080
# DASHBOARD_PORT=8080
# DASHBOARD_HOST=0.0.0.0

# --- Tuning (defaults shown) ---
# COMMAND_PREFIX=!
# DJ_ROLE_NAME=DJ
# CACHE_DIR=cache
# CACHE_LIMIT_MB=2048
# MAX_CACHE_DURATION=1800
# IDLE_TIMEOUT=600
# ALONE_TIMEOUT=180
# LOG_LEVEL=INFO
# YouTube clients yt-dlp may use; the TV ones give stream URLs FFmpeg can't open
# YOUTUBE_PLAYER_CLIENTS=default,-tv,-tv_downgraded,-tv_samsung,-tv_simply
